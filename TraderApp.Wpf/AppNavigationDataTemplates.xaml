<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TraderApp.Wpf.ViewModels"
                    xmlns:views="clr-namespace:TraderApp.Wpf.Views">

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView DataContext="{Binding}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PortfolioViewModel}">
        <views:PorfolioView DataContext="{Binding}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BuyViewModel}">
        <views:BuyView DataContext="{Binding}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SellViewModel}">
        <views:SellView DataContext="{Binding}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView DataContext="{Binding}"
                         Password="{Binding Password}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
        <views:RegisterView DataContext="{Binding}"
                            Password="{Binding Password}"
                            ConfirmPassword="{Binding ConfirmPassword}"/>
    </DataTemplate>
</ResourceDictionary>