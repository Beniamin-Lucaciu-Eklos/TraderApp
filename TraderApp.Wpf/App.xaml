<Application x:Class="TraderApp.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TraderApp.Wpf.ViewModels"
             xmlns:views="clr-namespace:TraderApp.Wpf.Views"
             xmlns:local="clr-namespace:TraderApp.Wpf">
    <Application.Resources>
        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Common.xaml" />
                <ResourceDictionary Source="/Styles/NavigationBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PortfolioViewModel}">
                <views:PorfolioView DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BuyViewModel}">
                <views:BuyView DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SellViewModel}">
                <views:SellView DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView DataContext="{Binding}"
                                 Password="{Binding Password}"/>
            </DataTemplate>
        </ResourceDictionary>

    </Application.Resources>
</Application>
