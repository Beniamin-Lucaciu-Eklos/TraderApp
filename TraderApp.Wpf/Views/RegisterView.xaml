<UserControl x:Class="TraderApp.Wpf.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TraderApp.Wpf.Views"
             mc:Ignorable="d" 
             FontSize="20"
             xmlns:vm="clr-namespace:TraderApp.Wpf.ViewModels"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisbilityConverter"/>
    </UserControl.Resources>

    <UserControl.Background>
        <ImageBrush Stretch="UniformToFill"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    ImageSource="/Resources/images/trade_app_icon.jpg" />
    </UserControl.Background>
    
    <Border BorderBrush="{StaticResource PrimaryBrush2}"
            Background="White"
            CornerRadius="10"
            BorderThickness="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="50"
            Margin="25">
        <!--<Border.Effect>
            <DropShadowEffect Color="LightBlue"
                              BlurRadius="2"/>
        </Border.Effect>-->

        <Grid FocusManager.FocusedElement="{Binding ElementName=txtUserName}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Trader Register" 
                       FontSize="48" 
                       HorizontalAlignment="Center"/>

            <TextBlock Text="A simple mvvm classic trade app" 
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0 10"
                       FontWeight="Thin"
                       Grid.Row="1"/>

            <Grid Grid.IsSharedSizeScope="True"
                  Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Email"/>
                    <TextBox Grid.Column="1"
                             Margin="20 0 0 0"
                             x:Name="txtEmail"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="UserName"/>
                    <TextBox Grid.Column="1"
                             Margin="20 0 0 0"
                             x:Name="txtUserName"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>   

                <Grid Grid.Row="2" Margin="0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Password"/>
                    <PasswordBox Grid.Column="1"
                                 Background="White"
                                 Margin="20 0 0 0"
                                 x:Name="pbPassword"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Confirm Password"/>
                    <PasswordBox Grid.Column="1"
                                 Background="White"
                                 Margin="20 0 0 0"
                                 x:Name="confirmPassword"/>
                </Grid>

                <Button Grid.Row="4" 
                        Grid.Column="2"   
                        IsDefault="True"
                        HorizontalAlignment="Center"
                        Command="{Binding RegisterCommand}" 
                        Content="Register"/>

                <Button Grid.Row="5" 
                        Margin="0 10 0 0"
                        Background="Transparent"
                        Foreground="Blue"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Command="{Binding ViewLoginCommand}" 
                        Content="Already have account ?"/>


                <TextBlock DataContext="{Binding ErrorMessageViewModel}"
                           Text="{Binding Message}" 
                           HorizontalAlignment="Center"
                           Margin="0 10 0 0"
                           Visibility="{Binding HasMessage, Converter={StaticResource booleanToVisbilityConverter}}"
                           Foreground="DarkRed"
                           Grid.Row="6"/>
            </Grid>
        </Grid>        
    </Border>
</UserControl>
